{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Gateway": {
        "Url": "http://localhost:8000"
      }
    }
  },
  "ReverseProxy": {
    "Routes": {
      "products-route": {
        "ClusterId": "products-cluster",
        "Match": {
          "Path": "/products/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/products" },
          { "PathPrefix": "/api/products" },
          { "RequestHeader": "X-Forwarded-By", "Set": "YarpGateway" }
        ]
      }
    },
    "Clusters": {
      "products-cluster": {
        "//LoadBalancingPolicy": "One of: RoundRobin | PowerOfTwoChoices | Random | LeastRequests | FirstAlphabetical | WeightedRoundRobin (custom). Edit and save to re-apply without a restart.",
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Policy": "ConsecutiveFailures",
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Path": "/health"
          }
        },
        "Metadata": {
          "ConsecutiveFailuresHealthPolicy.Threshold": "2"
        },
        "Destinations": {
          "products-5000": {
            "Address": "http://localhost:5000/",
            "Metadata": { "Weight": "3" }
          },
          "products-5001": {
            "Address": "http://localhost:5001/",
            "Metadata": { "Weight": "1" }
          },
          "products-5002": {
            "Address": "http://localhost:5002/",
            "Metadata": { "Weight": "1" }
          },
          "products-5003": {
            "Address": "http://localhost:5003/",
            "Metadata": { "Weight": "2" }
          },
          "products-5004": {
            "Address": "http://localhost:5004/",
            "Metadata": { "Weight": "1" }
          }
        }
      }
    }
  }
}
