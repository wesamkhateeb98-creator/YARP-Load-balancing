# Control panel for the Docker demo. Consumed by docker-compose.yml.

# Load balancing algorithm the gateway uses.
# RoundRobin | PowerOfTwoChoices | Random | LeastRequests | FirstAlphabetical | WeightedRoundRobin
# Change it, then apply with:  docker compose up -d gateway
LB_POLICY=RoundRobin

# Requests sent by:  docker compose --profile tools run --rm loadtest
REQUESTS=25

# Artificial latency in ms on products-5002 only. Raise it to ~400 to make
# load-aware policies visibly route around a slow instance.
PRODUCTS_5002_LATENCY_MS=0
